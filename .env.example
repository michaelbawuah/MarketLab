# Optional server-side Alpha Vantage key. Leave blank to use IBM demo or request-only keys.
# Hosted secrets are configured in Sites, separately from this local environment file.
ALPHA_VANTAGE_API_KEY=

# Production workspace allowlist. Shared report pages remain anonymous/read-only.
# Set the Site owner's verified ChatGPT email in Sites; never commit its value.
WORKSPACE_OWNER_EMAIL=
# Enable only after public report access is approved and the Site audience allows it.
PUBLIC_REPORT_SHARING_ENABLED=false

# Optional private background service. Leave both blank for the current D1 workflow.
RESEARCH_SERVICE_URL=
RESEARCH_SERVICE_SECRET=

# Standalone Node service only; Mongo credentials never reach the browser.
MONGODB_URI=
MONGODB_DATABASE=marketlab
RESEARCH_HOST=127.0.0.1
RESEARCH_PORT=8788
RESEARCH_WORKERS=2
RESEARCH_ENGINE=cpp-verify
