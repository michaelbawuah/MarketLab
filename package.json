{
  "name": "marketlab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "pnpm test:unit",
    "typecheck": "tsc --noEmit",
    "native:build": "node scripts/build-native.mjs",
    "test:native": "node --experimental-strip-types --test tests/cross-check/native.test.ts",
    "test:service": "node --experimental-strip-types --test tests/integration/service.test.ts tests/integration/lease-clock.test.ts tests/integration/crash-recovery.test.ts",
    "test:service:local": "node scripts/test-service-local.mjs",
    "service:start": "node --experimental-strip-types services/research/server.ts",
    "service:submit": "node --experimental-strip-types scripts/research-client.ts",
    "bench:native": "node --experimental-strip-types scripts/benchmark-native.ts",
    "bench:service": "node --experimental-strip-types scripts/benchmark-service.ts",
    "demo:money": "node --experimental-strip-types scripts/demo-money.ts",
    "test:hosted": "node --experimental-strip-types scripts/test-hosted-sharing.ts",
    "verify:hosted": "pnpm build && pnpm test:hosted",
    "verify:python": "python3 verification/python/verify_research.py",
    "test:python": "python3 -m unittest discover -s verification/python -p 'test_*.py'",
    "test:parity": "node --experimental-strip-types scripts/test-python-parity.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:cross-check": "pnpm test:native && pnpm test:python && pnpm test:parity",
    "verify:ci": "pnpm typecheck && pnpm lint && pnpm native:build && pnpm test:unit && pnpm test:integration && pnpm test:cross-check && pnpm verify:hosted"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mongodb": "7.6.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "miniflare": "4.20260515.0",
    "node-api-headers": "1.8.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
